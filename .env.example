# Gemini (API / Netlify Functions — server-side only)
GEMINI_API_KEY=

# Supabase (web client — VITE_ prefix exposes to browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override API origin (default: same-origin /api in production, Vite proxy in dev)
# VITE_API_URL=

# Optional: Express CORS origin (default includes http://localhost:5173)
# CORS_ORIGIN=

# Optional: Netlify Function CORS (production site URL)
# ALLOWED_ORIGIN=https://your-site.netlify.app

# Optional: API port for local Express dev
# PORT=3001
